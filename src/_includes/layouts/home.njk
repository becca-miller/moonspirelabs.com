{% extends "layouts/base.njk" %}

{% block content %}
{# Hero Section #}
<section class="hero">
  <div class="container">
    <h1>{{ hero.header }}</h1>
    <p class="large">{{ hero.subheader }}</p>
    {% if hero.cta %}
      <a href="{{ hero.cta.link }}" class="btn btn--primary btn--large">{{ hero.cta.text }}</a>
    {% endif %}
  </div>
</section>

{# Services Section #}
<section class="services">
  <div class="container">
    <h2 class="section-header">{{ services.header }}</h2>

    <div class="services__grid">
      {% for item in services.items %}
      <article class="service-card">
        <h3 class="service-card__title">{{ item.title }}</h3>
        <p class="service-card__subtitle"><em>{{ item.subtitle }}</em></p>
        <div class="service-card__description">{{ item.description | markdown | safe }}</div>
        <p class="service-card__pricing"><em>{{ item.pricing }}</em></p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# How It Works Section #}
{% if how_it_works %}
<section class="how-it-works">
  <div class="container">
    <div class="content--medium">
      <h2 class="section-header">{{ how_it_works.header }}</h2>
      <p>{{ how_it_works.text }}</p>
      <p>{{ how_it_works.text2 }}</p>
      <p>{{ how_it_works.text3 }}</p>
    </div>
  </div>
</section>
{% endif %}

{# Who I Work With Section #}
{% if who %}
<section class="who">
  <div class="container">
    <div class="content--medium">
      <h2 class="section-header">{{ who.header }}</h2>
      <ul class="who__list">
        {% for item in who.items %}
          <li>{{ item | safe }}</li>
        {% endfor %}
      </ul>
      {% if who.note %}
        <p class="who__note">{{ who.note | safe }}</p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# CTA Section #}
<section class="cta">
  <div class="container container--narrow">
    <h2 class="cta__header">{{ cta.header }}</h2>
    <p class="cta__text">{{ cta.text }}</p>
    {% if cta.button %}
      <a href="{{ cta.button.link }}" class="btn btn--primary btn--large">{{ cta.button.text }}</a>
    {% endif %}
  </div>
</section>

{% endblock %}
