{% extends "layouts/base.njk" %}
{% block content %}
<article class="intro">
	<div class="[ intro__header ]">
		<h1 class="[ intro__heading ] [ weight-normal text-400 md:text-600 ]">
			{{ intro.headerText }}
		</h1>
	</div>
	<div class="[ intro__content ] [ flow ]">
		<p class="intro__body">{{ intro.bodyText }}</p>
	</div>
</article>
{% endblock %}
