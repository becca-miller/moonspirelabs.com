{% extends "layouts/base.njk" %}

{% block content %}
{# Hero Section #}
<section class="hero">
  <div class="container">
    <h1>{{ hero.header }}</h1>
    <p class="large">{{ hero.subheader }}</p>
  </div>
</section>

{# Starling Section #}
<section class="product-summary">
  <div class="container">
    <div class="content--narrow">
      <div class="product-title">
        <img src="/assets/starling/starling-icon.webp" alt="" width="56" height="56" class="product-title__icon">
        <h2 class="section-header">{{ starling.header }}</h2>
      </div>
      <p class="product-summary__tagline"><strong>{{ starling.tagline }}</strong></p>
      <p>{{ starling.summary }}</p>
      <p>Available for Windows and Linux on <a href="{{ starling.links.itch }}">itch.io</a> and <a href="{{ starling.links.gumroad }}">Gumroad</a>.</p>
      <a href="/starling/" class="btn btn--primary">Learn more about Starling</a>
    </div>
  </div>
</section>

{# Newsletter CTA Section #}
{% include "components/newsletter.njk" %}

{% endblock %}
