{% extends "layouts/base.njk" %}

{% block content %}
{# Hero Section #}
<section class="hero">
  <div class="container">
    <h1>{{ hero.header }}</h1>
    <p class="large">{{ hero.subheader }}</p>
  </div>
</section>

{# Starling Section #}
<section class="product-summary">
  <div class="container">
    <div class="product-title">
      <img src="/assets/starling/starling-icon.webp" alt="" width="56" height="56" class="product-title__icon">
      <h2 class="section-header">{{ starling.header }}</h2>
    </div>
    <p class="product-summary__tagline"><strong>{{ starling.tagline }}</strong></p>
    <p>{{ starling.summary }}</p>
    <div class="store-links">
      <a href="{{ starling.links.itch }}" class="btn btn--primary">Get it on itch.io</a>
      <a href="{{ starling.links.gumroad }}" class="btn btn--secondary">Get it on Gumroad</a>
      <a href="/starling/" class="btn btn--tertiary">Learn more</a>
    </div>
  </div>
</section>

{# Newsletter CTA Section #}
{% include "components/newsletter.njk" %}

{% endblock %}
