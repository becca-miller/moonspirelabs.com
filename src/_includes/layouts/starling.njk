{% extends "layouts/base.njk" %}

{% block content %}
{# Hero Section #}
<section class="hero">
  <div class="container">
    <div class="product-title">
      <img src="/assets/starling/starling-icon.webp" alt="" width="96" height="96" class="product-title__icon">
      <h1>{{ hero.header }}</h1>
    </div>
    <p class="large"><em>{{ hero.tagline }}</em></p>
  </div>
</section>

{# Intro Section #}
<section class="product-feature product-intro">
  <div class="container container--medium">
    <p>{{ intro.description }}</p>
    <p><strong>{{ platforms }}</strong></p>
    <div class="store-links">
      <a href="{{ links.itch }}" class="btn btn--primary">Get it on itch.io</a>
      <a href="{{ links.gumroad }}" class="btn btn--secondary">Get it on Gumroad</a>
    </div>
  </div>
</section>

{# Feature band: how it works, the two features, and a closing call to action #}
<div class="product-band">
<section class="product-feature product-band__intro">
  <div class="container container--medium">
    <p class="eyebrow">{{ how_it_works.label }}</p>
    <p class="product-band__lead">{{ how_it_works.lead }}</p>
  </div>
</section>

{# Review Section #}
<section class="product-feature">
  <div class="container container--medium">
    <h2 class="section-header">{{ review.header }}</h2>
    {{ review.text | markdown | safe }}
    {% set carousel = review.carousel %}
    {% include "components/carousel.njk" %}
  </div>
</section>

{# Listen Section #}
<section class="product-feature">
  <div class="container container--medium">
    <h2 class="section-header">{{ listen.header }}</h2>
    <p>{{ listen.text }}</p>
    {% set carousel = listen.carousel %}
    {% include "components/carousel.njk" %}
  </div>
</section>

{# Features Section #}
<section class="product-feature">
  <div class="container container--medium">
    <h2 class="section-header">{{ features.header }}</h2>
    <ul>
      {% for item in features.items %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

{# Closing Section #}
<section class="product-feature product-closing">
  <div class="container container--medium">
    <p><strong>{{ closing.text }}</strong></p>
    <div class="store-links">
      <a href="{{ links.itch }}" class="btn btn--primary">Get it on itch.io</a>
      <a href="{{ links.gumroad }}" class="btn btn--secondary">Get it on Gumroad</a>
    </div>
  </div>
</section>
</div>

{# Newsletter CTA Section #}
{% include "components/newsletter.njk" %}

<script src="/assets/js/carousel.js" defer></script>
{% endblock %}
