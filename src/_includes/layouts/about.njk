{% extends "layouts/base.njk" %}

{% block content %}
{# Hero Section #}
<section class="hero">
  <div class="container">
    <h1>{{ hero.header }}</h1>
    <p class="large">{{ hero.subheader }}</p>
  </div>
</section>

{# Background Section #}
<section class="background">
  <div class="container--text">
    <h2 class="section-header">Background</h2>
    {% for paragraph in background.paragraphs %}
      <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
</section>

{# CTA Section #}
<section class="cta">
  <div class="container--narrow">
    <h2 class="cta__header">{{ cta.header }}</h2>
    <p class="cta__text">{{ cta.text }}</p>
  </div>
</section>

{% endblock %}
